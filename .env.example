# prosapia configuration — copy to `.env` and fill in the paths for the tools
# you use. You only need the variables for the tools you actually run.
#
#   cp .env.example .env
#
# See docs/configuration.md for the full reference.

# ── Tool discovery ───────────────────────────────────────────────────────────
# Extra directories to load custom tools from (os.pathsep-separated).
# Later directories win, so a tool whose `name` matches a built-in shadows it.
# Point this at a shared location to reuse custom tools across environments.
# PROSAPIA_TOOLS_DIR="/shared/lab/prosapia-tools:./tools"

# Interpreter for pipeline tools that run Python per array task (e.g.
# align_symm_axis). Defaults to the environment's own python when unset.
# PIPELINE_PYTHON=""

# ── RFdiffusion (rfdiffusion) ────────────────────────────────────────────────
RFDIFFUSION="/path/to/RFdiffusion"
RFDIFFUSION_ENV="/path/to/conda_envs/SE3nv/bin/python"
RUN_INFERENCE="/path/to/RFdiffusion/scripts/run_inference.py"

# ── RFdiffusion3 / foundry (rfdiffusion3) ────────────────────────────────────
# FOUNDRY_ENV_NAME: conda env where rc-foundry[rfd3] is installed; the sbatch
# activates it (via CONDA_PREFIX) and calls `rfd3` directly.
# RFD3_CKPT is optional (foundry auto-discovers checkpoints after
# `foundry install rfd3`).
FOUNDRY_ENV_NAME="foundry"
RFD3_CKPT=""

# ── ProteinMPNN (mpnn_seqs) ──────────────────────────────────────────────────
PROTEIN_MPNN="/path/to/ProteinMPNN"
PROTEIN_MPNN_PYTHON="/path/to/python"

# ── AlphaFold3 (alphafold3) ──────────────────────────────────────────────────
# Container image plus the model parameters and public databases it binds in.
AF3_CONTAINER="/path/to/alphafold3.sif"
AF3_PARAMETERS="/path/to/af3/models"
AF3_DATABASE="/path/to/af3/public_databases"

# ── ColabFold (colabfold) ────────────────────────────────────────────────────
# Script sourced to activate the ColabFold environment.
COLABFOLD_ACTIVATE="/path/to/activate_colabfold.sh"

# ── OpenFold3 (openfold3) ────────────────────────────────────────────────────
OPENFOLD_ACTIVATE="/path/to/activate_openfold.sh"

# ── Boltz (lmi4boltz) ────────────────────────────────────────────────────────
BOLTZ_ENV_NAME="boltz"
# Optional prediction tuning:
# USE_MSA="false"                 # true → run with an MSA; default empty MSA
# TEMPLATE_CIF=""                 # path to a template CIF, if any
# TEMPLATE_THRESHOLD="2.0"        # template distance threshold

# ── USalign (USalign) ────────────────────────────────────────────────────────
USALIGN_BIN="/path/to/USalign"

# ── Rosetta (rosetta_relax, make_symmdef) ────────────────────────────────────
ROSETTA="/path/to/rosetta"
# ROSETTASCRIPTS=""               # override the rosetta_scripts binary if needed
